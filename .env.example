# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
# The origin the site is served from, with no trailing slash. Every canonical
# URL, Open Graph tag, sitemap entry and piece of structured data is built from
# it, so on a production deploy this MUST be the real domain — left at
# localhost, the sitemap tells search engines to crawl a machine they cannot
# reach.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Postgres in Docker (see README). One URL is enough; migrations and the
# runtime can share a direct connection.
DATABASE_URL="postgresql://iwm:iwm@localhost:5432/iwm?schema=public"

# Supabase needs two, because the two poolers do different jobs:
#   6543  transaction mode, for the app. Many short-lived connections.
#   5432  session mode, for migrations and the seed. Holds one backend, which
#         Prisma's migration advisory lock requires.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# DIRECT_URL falls back to DATABASE_URL when unset, so a local database needs
# only the first line.

# ---------------------------------------------------------------------------
# Authentication (Fase 8)
# ---------------------------------------------------------------------------
# Signs the session JWT. Required. Rotating it signs everybody out.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# Set only if the deployment sits behind a proxy that rewrites the host, or
# NextAuth will build callback URLs against the internal hostname.
# AUTH_URL="https://indonesiawristwatchmuseum.com"
