# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds placeholders and no secrets. A clone with
# no .env.example leaves the next person guessing which variables exist.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS AppleDouble sidecar files (this project lives on an exFAT volume)
._*
.DS_Store

# Local secrets
.env
.env.local

# Prisma generated client
src/generated/

# Lighthouse reports, written into the project root by `npx lighthouse --view`
*.report.html
*.report.json
